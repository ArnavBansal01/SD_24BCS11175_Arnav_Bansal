        <mxCell id="eO-nkDByEVg7ZUlRZD5F-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Scalability&lt;div&gt;Low latency&lt;/div&gt;&lt;div&gt;Available 24/7&lt;/div&gt;&lt;div&gt;Unique Urls&lt;/div&gt;&lt;div&gt;Performance ( should handle many requests at same time)&amp;nbsp;&lt;/div&gt;&lt;div&gt;Security&lt;/div&gt;&lt;div&gt;Durability of data ( once created shouldnt be lost )&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
